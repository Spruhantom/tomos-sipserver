#!/usr/bin/env bash
set -Eeuo pipefail
systemctl is-active --quiet asterisk.service || { echo "Asterisk service is not active." >&2; exit 1; }
output="$(asterisk -rx 'pjsip show endpoints' 2>&1)" || { printf '%s\n' "$output" >&2; exit 1; }
for extension in 100 101; do
  if ! grep -Fq "${extension}/${extension}" <<<"$output"; then
    echo "Expected PJSIP endpoint ${extension}/${extension} was not found." >&2
    printf '%s\n' "$output" >&2
    exit 1
  fi
done
echo "TomOS SIP foundation is active; PJSIP endpoints 100 and 101 are loaded."
