#!/usr/bin/env bash
set -Eeuo pipefail
systemctl is-active --quiet asterisk.service || { echo "Asterisk service is not active." >&2; exit 1; }
output="$(asterisk -rx 'pjsip show endpoints' 2>&1)" || { printf '%s\n' "$output" >&2; exit 1; }
for extension in 100 101; do
  grep -Eq "(Endpoint:| ${extension}/|${extension}[[:space:]])" <<<"$output" || {
    echo "Expected PJSIP endpoint $extension was not found." >&2
    printf '%s\n' "$output" >&2
    exit 1
  }
done
modules="$(asterisk -rx 'module show like chan_sccp.so' 2>&1)" || { printf '%s\n' "$modules" >&2; exit 1; }
grep -Fq 'chan_sccp.so' <<<"$modules" || { echo "Cisco SCCP channel driver is not loaded." >&2; printf '%s\n' "$modules" >&2; exit 1; }
asterisk -rx 'sccp show devices' >/dev/null 2>&1 || { echo "SCCP CLI is unavailable; chan_sccp did not initialise." >&2; exit 1; }
echo "TomOS SIP foundation is active; PJSIP endpoints 100 and 101 and the Cisco SCCP driver are loaded."
